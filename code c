
#include <stdio.h>

#define N 6

void docMaTran(int a[N][N], char tenFile[]) {
    FILE *f = fopen(tenFile, "r");

    if (f == NULL) {
        printf("Khong mo duoc file!\n");
        return;
    }

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            fscanf(f, "%d", &a[i][j]);
        }
    }

    fclose(f);
}

void inMaTran(int a[N][N]) {
    char dinh[N] = {'A', 'B', 'C', 'D', 'E', 'F'};

    printf("   ");
    for (int i = 0; i < N; i++) {
        printf("%4c", dinh[i]);
    }
    printf("\n");

    for (int i = 0; i < N; i++) {
        printf("%c  ", dinh[i]);

        for (int j = 0; j < N; j++) {
            printf("%4d", a[i][j]);
        }

        printf("\n");
    }
}

int main() {
    int a[N][N];

    docMaTran(a, "matran.txt");

    printf("Ma tran trong so:\n");
    inMaTran(a);

    return 0;
}
